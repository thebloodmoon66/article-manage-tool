<Window x:Class="PaperSubmissionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PaperSubmissionManager"
        Title="论文投稿管理助手" Height="900" Width="1480" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CopyableCellTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="ToolTip" Value="可选中文字并按 Ctrl+C 复制"/>
            <EventSetter Event="GotKeyboardFocus" Handler="CopyableCellTextBox_GotKeyboardFocus"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryDarkBrush}" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="论文投稿管理助手" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="期刊资料 · 论文附件 · 投稿历史 · 作者与期刊工作台" Foreground="#C9D9F2" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="DataPathText" Foreground="#C9D9F2" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="620" TextDecorations="Underline" Cursor="Hand" ToolTip="点击重新选择数据目录并重启软件" MouseLeftButtonUp="DataPathText_MouseLeftButtonUp"/>
                    <TextBlock x:Name="StatusText" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                    <WrapPanel HorizontalAlignment="Right"><Button Content="导出数据" Padding="12,3" MinHeight="26" Click="ExportBusinessData_Click"/><Button Content="导入数据" Padding="12,3" MinHeight="26" Click="ImportBusinessData_Click"/></WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Margin="12" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="期刊资料查询及修改">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}" PreviewKeyDown="JournalFilter_PreviewKeyDown">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Width="230"><TextBlock Text="期刊名称 / 关键字"/><TextBox x:Name="JournalKeywordBox"/></StackPanel>
                                <StackPanel Width="170"><TextBlock Text="ISSN"/><TextBox x:Name="JournalIssnBox"/></StackPanel>
                                <StackPanel Width="220"><TextBlock Text="学科领域"/><TextBox x:Name="JournalSubjectBox"/></StackPanel>
                                <StackPanel Width="220"><TextBlock Text="学科段"/><TextBox x:Name="JournalCategoryBox"/></StackPanel>
                                <StackPanel Width="105"><TextBlock Text="A / B 类"/><ComboBox x:Name="JournalRankBox"><ComboBoxItem Content="全部" IsSelected="True"/><ComboBoxItem Content="A类"/><ComboBoxItem Content="B类"/></ComboBox></StackPanel>
                                <StackPanel Width="120"><TextBlock Text="分区"/><ComboBox x:Name="JournalQuartileBox"><ComboBoxItem Content="全部" IsSelected="True"/><ComboBoxItem Content="1区"/><ComboBoxItem Content="2区"/><ComboBoxItem Content="3区"/><ComboBoxItem Content="4区"/><ComboBoxItem Content="未收录"/><ComboBoxItem Content="未录"/><ComboBoxItem Content="LetPub未检索到"/><ComboBoxItem Content="LetPub未检索到（会议）"/></ComboBox></StackPanel>
                                <StackPanel Width="115"><TextBlock Text="是否 OA"/><ComboBox x:Name="JournalOaBox"><ComboBoxItem Content="全部" IsSelected="True"/><ComboBoxItem Content="是"/><ComboBoxItem Content="否"/><ComboBoxItem Content="未知/混合"/></ComboBox></StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <StackPanel Width="120"><TextBlock Text="IF 最小值"/><TextBox x:Name="IfMinBox"/></StackPanel>
                                <StackPanel Width="120"><TextBlock Text="IF 最大值"/><TextBox x:Name="IfMaxBox"/></StackPanel>
                                <StackPanel Width="140"><TextBlock Text="年文章数最小"/><TextBox x:Name="ArticlesMinBox"/></StackPanel>
                                <StackPanel Width="140"><TextBlock Text="年文章数最大"/><TextBox x:Name="ArticlesMaxBox"/></StackPanel>
                                <Button Content="查询（Enter）" Style="{StaticResource PrimaryButton}" Click="SearchJournals_Click" VerticalAlignment="Bottom"/>
                                <Button Content="清空筛选" Click="ClearJournalFilter_Click" VerticalAlignment="Bottom"/>
                                <Button Content="导入 XLSX" Click="ImportJournals_Click" VerticalAlignment="Bottom"/>
                                <Button Content="修改选中期刊" Click="EditJournal_Click" VerticalAlignment="Bottom"/>
                                <Button Content="查看三代备份" Click="ShowBackups_Click" VerticalAlignment="Bottom"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="JournalGrid" Grid.Row="1" Margin="8" IsReadOnly="True" MouseDoubleClick="JournalGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="学科段" Binding="{Binding Category}" Width="220"/><DataGridTextColumn Header="等级" Binding="{Binding Rank}" Width="65"/>
                            <DataGridTextColumn Header="ISSN" Binding="{Binding Issn}" Width="110"/><DataGridTextColumn Header="期刊名称" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="IF" Binding="{Binding ImpactFactorText}" Width="90"/><DataGridTextColumn Header="分区" Binding="{Binding Quartile}" Width="100"/>
                            <DataGridTextColumn Header="学科领域" Binding="{Binding SubjectArea}" Width="2*"/><DataGridTextColumn Header="OA" Binding="{Binding OaText}" Width="90"/>
                            <DataGridTextColumn Header="年文章数" Binding="{Binding AnnualArticlesText}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="JournalCountText" Grid.Row="2" Margin="12,4" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </TabItem>

            <TabItem Header="论文投稿管理">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top"><Button Content="新建论文并导入附件" Style="{StaticResource PrimaryButton}" Click="NewPaper_Click"/><Button Content="刷新" Click="RefreshPapers_Click"/><Button Content="删除" Style="{StaticResource DangerButton}" Click="DeletePaper_Click"/></WrapPanel>
                            <ListBox x:Name="PaperGrid" SelectionChanged="PaperGrid_SelectionChanged" MouseDoubleClick="PaperGrid_MouseDoubleClick" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="BorderBrush" Value="#E1E7F0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#17202A"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#EAF2FD"/>
                                                <Setter Property="Foreground" Value="#17202A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Padding="4,2">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" Foreground="#17202A" TextWrapping="Wrap" Margin="4,5,6,5"/>
                                            </Expander.Header>
                                            <Border Margin="25,0,5,8" Padding="10,8" Background="#F7F9FC" BorderBrush="#DFE6EF" BorderThickness="1" CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="投稿期刊" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LatestJournalDisplay}" FontSize="13" Foreground="#2F3A46" TextWrapping="Wrap" Margin="0,2"/>
                                                    <TextBlock Grid.Row="1" Text="当前状态" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestSubmissionStatusDisplay}" FontSize="13" FontWeight="SemiBold" Margin="0,2">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="#202124"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LatestSubmissionStatus}" Value="已投稿"><Setter Property="Foreground" Value="#198754"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding LatestSubmissionStatus}" Value="未投稿"><Setter Property="Foreground" Value="#202124"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding LatestSubmissionStatus}" Value="已拒稿"><Setter Property="Foreground" Value="#D13438"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding LatestSubmissionStatus}" Value="返修中"><Setter Property="Foreground" Value="#D97706"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding LatestSubmissionStatus}" Value="投稿中"><Setter Property="Foreground" Value="#2563EB"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding LatestSubmissionStatus}" Value=""><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" Text="附件数量" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" Foreground="#2F3A46" Margin="0,2"><Run Text="{Binding AttachmentCount}"/><Run Text=" 个"/></TextBlock>
                                                    <TextBlock Grid.Row="3" Text="投稿记录" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="13" Foreground="#2F3A46" Margin="0,2"><Run Text="{Binding SubmissionCount}"/><Run Text=" 条"/></TextBlock>
                                                    <TextBlock Grid.Row="4" Text="创建时间" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CreatedAtDisplay}" FontSize="13" Foreground="#2F3A46" Margin="0,2"/>
                                                </Grid>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDE4EE"/>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="论文详情" FontSize="19" FontWeight="Bold"/><TextBlock Text="名称" Margin="0,10,0,0"/><TextBox x:Name="PaperNameBox"/><TextBlock Text="备注"/><TextBox x:Name="PaperNotesBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"/><Button Content="保存论文详情" HorizontalAlignment="Left" Click="SavePaperDetails_Click"/></StackPanel></Border>
                            <Border Style="{StaticResource CardBorder}" AllowDrop="True" DragOver="AttachmentArea_DragOver" Drop="AttachmentArea_Drop"><StackPanel><DockPanel><TextBlock Text="附件（可从文件夹拖入）" FontSize="18" FontWeight="Bold"/><WrapPanel DockPanel.Dock="Right"><Button Content="添加附件" Click="AddPaperAttachment_Click"/><Button Content="打开" Style="{StaticResource PrimaryButton}" Click="OpenPaperAttachment_Click"/><Button Content="在文件夹中显示" Click="ShowPaperAttachmentInFolder_Click"/><Button Content="修改文件名" Click="RenamePaperAttachment_Click"/><Button Content="删除" Style="{StaticResource DangerButton}" Click="DeletePaperAttachment_Click"/></WrapPanel></DockPanel><DataGrid x:Name="AttachmentGrid" AllowDrop="True" IsReadOnly="True" Height="180" MouseDoubleClick="AttachmentGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="管理名称" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="真实文件名" Binding="{Binding ActualFileName}" Width="*"/><DataGridTextColumn Header="导入时间" Binding="{Binding CreatedAt}" Width="160"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="投稿状态" FontSize="19" FontWeight="Bold"/><WrapPanel DockPanel.Dock="Right"><Button Content="记录投稿期刊" Click="AddSubmission_Click"/><Button Content="打开期刊栏目" Click="OpenSubmissionWorkspace_Click"/><Button Content="删除投稿记录" Style="{StaticResource DangerButton}" Click="DeleteSubmission_Click"/></WrapPanel></DockPanel>
                                    <TextBlock Text="选择投稿期刊历史" Margin="4,10,4,2" Foreground="{StaticResource MutedBrush}"/>
                                    <ComboBox x:Name="SubmissionGrid" DisplayMemberPath="JournalName" SelectionChanged="SubmissionGrid_SelectionChanged"/>
                                    <Border Background="#F4F7FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,8">
                                        <StackPanel>
                                            <TextBlock x:Name="SubmissionHeaderText" FontSize="17" FontWeight="Bold"/>
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock Text="当前投稿状态：" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                                <ComboBox x:Name="SubmissionStatusBox" Width="140" HorizontalAlignment="Left" IsEnabled="False" SelectionChanged="SubmissionStatusBox_SelectionChanged"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <DockPanel><TextBlock Text="状态纪要（新到旧）" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><WrapPanel DockPanel.Dock="Right"><Button Content="新增状态" Style="{StaticResource PrimaryButton}" Click="AddSubmissionNote_Click"/><Button Content="编辑纪要" Click="EditSubmissionNote_Click"/><Button Content="删除纪要" Style="{StaticResource DangerButton}" Click="DeleteSubmissionNote_Click"/></WrapPanel></DockPanel>
                                    <DataGrid x:Name="SubmissionNoteGrid" IsReadOnly="True" Height="240"><DataGrid.Columns><DataGridTextColumn Header="纪要内容" Binding="{Binding Content}" Width="*"/><DataGridTextColumn Header="填写时间" Binding="{Binding RecordedAt}" Width="190"/></DataGrid.Columns></DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="作者信息管理">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="新建作者" Style="{StaticResource PrimaryButton}" Click="NewAuthor_Click"/><Button Content="刷新" Click="RefreshAuthors_Click"/><Button Content="删除作者" Style="{StaticResource DangerButton}" Click="DeleteAuthor_Click"/></WrapPanel><DataGrid x:Name="AuthorGrid" IsReadOnly="True" SelectionChanged="AuthorGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="作者名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="邮箱数" Binding="{Binding EmailCount}" Width="70"/><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="160"/></DataGrid.Columns></DataGrid></DockPanel></Border>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDE4EE"/>
                    <StackPanel Grid.Column="2"><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="作者信息" FontSize="19" FontWeight="Bold"/><TextBlock Text="作者名称" Margin="0,10,0,0"/><TextBox x:Name="AuthorNameBox"/><Button Content="保存名称" HorizontalAlignment="Left" Click="SaveAuthorName_Click"/></StackPanel></Border><Border Style="{StaticResource CardBorder}"><StackPanel><DockPanel><TextBlock Text="邮箱列表" FontSize="18" FontWeight="Bold"/><WrapPanel DockPanel.Dock="Right"><Button Content="增加邮箱栏" Style="{StaticResource PrimaryButton}" Click="AddAuthorEmail_Click"/><Button Content="修改邮箱" Click="EditAuthorEmail_Click"/><Button Content="删除邮箱" Style="{StaticResource DangerButton}" Click="DeleteAuthorEmail_Click"/></WrapPanel></DockPanel><DataGrid x:Name="AuthorEmailGrid" IsReadOnly="True" Height="360"><DataGrid.Columns><DataGridTemplateColumn Header="邮箱" ClipboardContentBinding="{Binding Email}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Email}" Style="{StaticResource CopyableCellTextBox}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="190"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="期刊投稿管理">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}"><DockPanel><WrapPanel DockPanel.Dock="Top"><Button Content="从数据库新建" Style="{StaticResource PrimaryButton}" Click="NewWorkspaceFromJournal_Click"/><Button Content="自定义新建" Click="NewCustomWorkspace_Click"/><Button Content="刷新" Click="RefreshWorkspaces_Click"/><Button Content="删除栏目" Style="{StaticResource DangerButton}" Click="DeleteWorkspace_Click"/></WrapPanel><DataGrid x:Name="WorkspaceGrid" IsReadOnly="True" SelectionChanged="WorkspaceGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="期刊栏目" Binding="{Binding JournalName}" Width="*"/><DataGridTextColumn Header="论文" Binding="{Binding PaperCount}" Width="55"/><DataGridTextColumn Header="账号" Binding="{Binding AccountCount}" Width="55"/></DataGrid.Columns></DataGrid></DockPanel></Border>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDE4EE"/>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="期刊投稿栏目" FontSize="19" FontWeight="Bold"/><TextBlock Text="期刊名（创建后不可修改）" Margin="0,10,0,0"/><TextBox x:Name="WorkspaceNameBox" IsReadOnly="True"/><TextBlock Text="投稿链接"/><DockPanel><Button DockPanel.Dock="Right" Content="打开链接" Click="OpenWorkspaceLink_Click"/><Button DockPanel.Dock="Right" Content="保存链接" Style="{StaticResource PrimaryButton}" Click="SaveWorkspaceLink_Click"/><TextBox x:Name="WorkspaceLinkBox"/></DockPanel></StackPanel></Border>
                        <Border Style="{StaticResource CardBorder}"><StackPanel><DockPanel><TextBlock Text="投稿账号" FontSize="18" FontWeight="Bold"/><WrapPanel DockPanel.Dock="Right"><Button Content="新建账号栏" Style="{StaticResource PrimaryButton}" Click="AddWorkspaceAccount_Click"/><Button Content="修改选中" Click="EditWorkspaceAccount_Click"/><Button Content="删除" Style="{StaticResource DangerButton}" Click="DeleteWorkspaceAccount_Click"/></WrapPanel></DockPanel><DataGrid x:Name="WorkspaceAccountGrid" IsReadOnly="True" SelectionUnit="Cell" ClipboardCopyMode="ExcludeHeader" Height="170"><DataGrid.Columns><DataGridTemplateColumn Header="栏位名称" ClipboardContentBinding="{Binding Label}" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Label}" Style="{StaticResource CopyableCellTextBox}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="账号" ClipboardContentBinding="{Binding AccountName}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding AccountName}" Style="{StaticResource CopyableCellTextBox}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="密码" ClipboardContentBinding="{Binding Password}" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Password}" Style="{StaticResource CopyableCellTextBox}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></Border>
                        <Border Style="{StaticResource CardBorder}"><StackPanel><DockPanel><TextBlock Text="关联投稿论文" FontSize="18" FontWeight="Bold"/><WrapPanel DockPanel.Dock="Right"><Button Content="关联论文" Style="{StaticResource PrimaryButton}" Click="LinkWorkspacePaper_Click"/><Button Content="打开论文" Click="OpenWorkspacePaper_Click"/><Button Content="取消关联" Style="{StaticResource DangerButton}" Click="UnlinkWorkspacePaper_Click"/></WrapPanel></DockPanel><DataGrid x:Name="WorkspacePaperGrid" IsReadOnly="True" Height="170"><DataGrid.Columns><DataGridTextColumn Header="论文名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="180"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                        <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="期刊数据库资料（实时联动）" FontSize="18" FontWeight="Bold"/><DataGrid x:Name="WorkspaceJournalDataGrid" IsReadOnly="True" Height="190"><DataGrid.Columns><DataGridTextColumn Header="学科段" Binding="{Binding Category}" Width="220"/><DataGridTextColumn Header="等级" Binding="{Binding Rank}" Width="60"/><DataGridTextColumn Header="ISSN" Binding="{Binding Issn}" Width="100"/><DataGridTextColumn Header="IF" Binding="{Binding ImpactFactorText}" Width="65"/><DataGridTextColumn Header="分区" Binding="{Binding Quartile}" Width="80"/><DataGridTextColumn Header="学科领域" Binding="{Binding SubjectArea}" Width="*"/><DataGridTextColumn Header="OA" Binding="{Binding OaText}" Width="75"/><DataGridTextColumn Header="年文章数" Binding="{Binding AnnualArticlesText}" Width="90"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
